{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orch",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "provider": {
    "glm52": {
      "name": "GLM-5.2 H200",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://34.90.144.79:30000/v1",
        "apiKey": "dummy"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2 (8xH200)",
          "limit": { "context": 131072, "output": 32768 }
        }
      }
    }
  },
  "model": "glm52/glm-5.2",
  "small_model": "glm52/glm-5.2",
  "skills": {
    "paths": ["skills"]
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}
